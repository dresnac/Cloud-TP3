# Lo genera `npm run config` a partir de los outputs de Terraform (archivo .env.local).
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_CLIENT_ID_CLIENTE=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLIENT_ID_REPARTIDOR=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Igual a la variable asignacion_timeout_segundos de Terraform.
VITE_OFERTA_TIMEOUT_SEGUNDOS=60
# Igual a la variable asignacion_espera_segundos de Terraform.
VITE_ESPERA_REPARTIDOR_SEGUNDOS=300
# Opcional, solo para probar contra un mock local (por defecto usa el endpoint de Cognito de la región).
# VITE_COGNITO_URL=http://localhost:8001/
